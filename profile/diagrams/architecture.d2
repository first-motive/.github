# Org-profile map: the data engine as one loop, drawn at repo granularity so a
# reader lands on something they can open. The node-level view of the same loop
# is fm-ros2's docs/diagrams/learning.d2 — that one names processes and topics,
# this one names the repos. Palette and stroke come from the shared styles.d2
# the render plane keeps in step with every other First Motive diagram.
...@styles
direction: right

robot: "fm-robot · real robot" { class: pkg }
sim: "fm-sim · simulation" { class: pkg }
teleop: "fm-teleop · teleop + autonomy" { class: pkg }
record: "episode recording" { class: art }
pipeline: "data pipeline" { class: art }
train: "train + serve" { class: art }

robot -> teleop
sim -> teleop
teleop -> record
record -> pipeline
pipeline -> train
train -> robot: deploy
